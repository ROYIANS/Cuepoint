{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "ui/**/*.d.ts",
    "../../packages/studio/src/features/references/documents/mammoth.d.ts",
    "../../packages/studio/src/app/vite-env.d.ts"
  ]
}
