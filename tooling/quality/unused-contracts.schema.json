{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue",
          "file",
          "count",
          "reason",
          "owner",
          "symbol",
          "evidence"
        ],
        "properties": {
          "issue": {
            "enum": [
              "binaries",
              "catalog",
              "catalogReferences",
              "dependencies",
              "devDependencies",
              "duplicates",
              "enumMembers",
              "exports",
              "files",
              "namespaceMembers",
              "optionalPeerDependencies",
              "types",
              "unlisted",
              "unresolved",
              "nsExports",
              "nsTypes"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 12
          },
          "owner": {
            "type": "string",
            "minLength": 3
          },
          "symbol": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "sha256"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
