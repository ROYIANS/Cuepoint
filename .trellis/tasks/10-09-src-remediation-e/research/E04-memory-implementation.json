    "createProjectMemory": {
      "reads": [
        "projects.get via project/owned",
        "projectMemories owner-index query via duplicateOrConflicts",
        "optional projectMemories.get via owned"
      ],
      "writes": [
        "optional replaced current/history and new current/history via persist"
      ]
    },
    "updateProjectMemory": {
      "reads": [
        "projects.get + projectMemories.get via owned",
        "projectMemories owner-index query via duplicateOrConflicts"
      ],
      "writes": [
        "projectMemories.put + projectMemoryVersions.add via persist"
      ]
    },
    "setProjectMemoryStatus": {
      "reads": [
        "projects.get + projectMemories.get via owned",
        "activation projectMemories owner-index query"
      ],
      "writes": [
        "changed current/status/history via persist; no-op preserves revision"
      ]
    },
    "replaceProjectMemory": {
      "reads": [
        "both project/current ownership reads via owned",
        "both revision guards",
        "projectMemories owner-index conflict query"
      ],
      "writes": [
        "old current/history followed by destination current/history via persist"
      ]
    },
    "deleteProjectMemory": {
      "reads": [
        "project/current ownership via owned",
        "revision guard",
        "memory-indexed versions with projectId predicate"
      ],
      "writes": [
        "projectMemories.delete",
        "projectMemoryVersions Collection.delete"
      ]
    }
  },
