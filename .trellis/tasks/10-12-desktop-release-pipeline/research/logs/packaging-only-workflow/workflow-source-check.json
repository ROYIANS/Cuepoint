    "node desktop/tauri/scripts/select-release-artifacts.mjs --kind set --output \"$RUNNER_TEMP/selected-set.json\"",
    "node desktop/tauri/scripts/publish-draft.mjs --directory \"$RUNNER_TEMP/release-set\""
