+#[cfg(test)]
+mod cuepoint_origin_tests {
+    use super::*;
+    #[test]
+    fn product_exact_origin_patterns_do_not_expand_hosts_ports_or_schemes() {
+        for (pattern, own, foreign) in [
+            ("https://api.example.test/*", "https://api.example.test/path?q=x", "https://api.example.test.evil/path"),
+            ("https://api.example.test:8443/*", "https://api.example.test:8443/path", "https://api.example.test:8444/path"),
+            ("http://127.0.0.1:3333/*", "http://127.0.0.1:3333/path", "http://127.0.0.1:3334/path"),
+            ("http://[\\:\\:1]:3333/*", "http://[::1]:3333/path", "http://[::1]:3334/path"),
+        ] {
+            let entry: Entry = pattern.parse().unwrap();
+            let scope = Scope::new(vec![Arc::new(entry)], vec![]);
+            assert!(scope.is_allowed(&own.parse().unwrap()), "{pattern} must match {own}");
+            assert!(!scope.is_allowed(&foreign.parse().unwrap()), "{pattern} must exclude {foreign}");
+        }
+    }
+}
