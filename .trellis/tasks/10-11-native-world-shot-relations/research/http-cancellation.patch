+// Cuepoint patch: closing a response must interrupt a body read that holds an Arc.
+// Mutex removes the original unsafe alias; Notify wakes a pending read on close.
+struct ReqwestResponse {
+    response: Mutex<Option<reqwest::Response>>,
+    canceled: AtomicBool,
+    closed: tokio::sync::Notify,
+}
+impl ReqwestResponse {
+    fn new(response: reqwest::Response) -> Self {
+        Self {response: Mutex::new(Some(response)), canceled: AtomicBool::new(false), closed: tokio::sync::Notify::new()}
+    }
+    async fn read_chunk(&self) -> Result<Option<Vec<u8>>> {
+        let notified = self.closed.notified();
+        tokio::pin!(notified);
+        // Register before checking the flag: close cannot be lost between the check and select.
+        notified.as_mut().enable();
+        let mut response = self.response.lock().await;
+        if self.canceled.load(Ordering::Acquire) {
+            response.take();
+            return Err(Error::RequestCanceled);
+        }
+        let Some(body) = response.as_mut() else {return Ok(None);};
+        let result = tokio::select! {
+            biased;
+            _ = &mut notified => Err(Error::RequestCanceled),
+            chunk = body.chunk() => chunk.map(|chunk| chunk.map(|chunk| chunk.to_vec())).map_err(Error::from),
+        };
+        if !matches!(result, Ok(Some(_))) {response.take();}
+        result
+    }
+}
+impl tauri::Resource for ReqwestResponse {
+    fn close(self: Arc<Self>) {
+        self.canceled.store(true, Ordering::Release);
+        self.closed.notify_waiters();
+        if let Ok(mut response) = self.response.try_lock() {response.take();}
+    }
+}
