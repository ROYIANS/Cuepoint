+// The official JS client creates a null body for these statuses and never calls
+// fetch_read_body/fetch_cancel_body. Keep its numeric rid reply shape while
+// releasing the otherwise unreachable native response before returning it.
+fn js_null_body(status: StatusCode) -> bool {
+    matches!(status.as_u16(), 101 | 103 | 204 | 205 | 304)
+}
+
+fn register_response(resources: &mut ResourceTable, response: reqwest::Response) -> ResourceId {
+    let null_body = js_null_body(response.status());
+    let rid = resources.add(ReqwestResponse::new(response));
+    if null_body {
+        // This rid was just added, so close can only succeed.
+        resources.close(rid).expect("newly registered HTTP response");
+    }
+    rid
+}
 
