  "permissions": ["allow-workspace-request", "allow-workspace-cancel", "allow-authorize-http-origin", "allow-product-save-begin", "allow-product-save-chunk", "allow-product-save-finish", "allow-product-save-cancel", "allow-product-print-storyboard", "allow-product-open-external", "core:webview:allow-print"]
}
