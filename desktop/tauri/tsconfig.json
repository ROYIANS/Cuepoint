{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {"@/*": ["../../src/*"]}
  },
  "include": ["scripts/**/*.ts", "ui/**/*.ts", "ui/**/*.tsx", "ui/**/*.d.ts", "../../src/lib/references/mammoth.d.ts"]
}
